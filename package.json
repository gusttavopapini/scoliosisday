{
  "name": "scoliosisday",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-seo.mjs",
    "lint": "oxlint",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "seed:admin": "node functions/scripts/seedAdmin.js",
    "audit:backfill": "node functions/scripts/backfillIndexes.js",
    "backfill": "node functions/scripts/backfillIndexes.js --apply",
    "audit:orphans": "node functions/scripts/purgeOrphanAuthUsers.js",
    "purge:orphans": "node functions/scripts/purgeOrphanAuthUsers.js --apply"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-text-style": "^3.28.0",
    "@tiptap/extension-underline": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "firebase": "^12.16.0",
    "i18n-iso-countries": "^7.14.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-circle-flags": "^0.0.30",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
