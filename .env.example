# Scoliosis Day — Variáveis de Ambiente
# Copie para .env.local e preencha com as credenciais do Firebase Console.
# NUNCA commite o arquivo .env.local no repositório.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Emulators — defina "true" para conectar aos emulators locais.
# Inicie-os com: npm run emulators
VITE_USE_EMULATORS=true

# Tradução automática (MyMemory) — e-mail de contato enviado no parâmetro
# `de`. Eleva o teto diário de ~5.000 para ~50.000 palavras. Não é
# credencial; se ficar vazio, o código usa scoliosisday@gmail.com.
# No script de migração em Node, a variável equivalente é
# TRANSLATION_CONTACT_EMAIL (sem o prefixo VITE_).
VITE_TRANSLATION_CONTACT_EMAIL=scoliosisday@gmail.com
