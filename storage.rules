rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn()  { return request.auth != null; }
    function claims()      { return request.auth.token; }
    function isApproved()  { return isSignedIn() && claims().status == 'approved'; }
    function isPanelUser() { return isApproved() && (claims().role == 'admin' || claims().role == 'staff'); }

    // Limites espelhados em src/services/storageService.js (UPLOAD_PRESETS).
    // A validação no cliente existe para dar erro imediato e legível; ESTA é a
    // que vale, porque o cliente é contornável — qualquer conta aprovada
    // poderia postar direto na API REST sem passar pelo formulário.
    function isImage(types) {
      return request.resource.contentType.matches('image/(' + types + ')');
    }
    function underMB(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // Leitura pública em todas as pastas: o site público exibe foto de
    // colaborador, logo de patrocinador e banner de evento sem autenticação.
    // A escrita continua restrita ao painel.
    //
    // O nome do arquivo é curinga (e não fixo em photo.{ext}) porque cada
    // upload gera um nome único — trocar um JPG por um PNG não pode deixar o
    // antigo para trás, e é deleteFile() quem apaga o anterior.

    // ── Fotos de colaborador ──
    match /collaborators/{collaboratorId}/{fileName} {
      allow read:  if true;
      allow write: if isPanelUser() && underMB(2) && isImage('jpeg|png|webp');
    }

    // ── Logos de patrocinador ──
    // SVG entra aqui: as logos são renderizadas em <img>, contexto em que
    // script embutido não executa.
    match /sponsors/{sponsorId}/{fileName} {
      allow read:  if true;
      allow write: if isPanelUser() && underMB(1) && isImage('png|svg\\+xml|webp');
    }

    // ── Galeria do evento ──
    // Declarada antes do curinga de banner: em Storage Rules o match mais
    // específico é avaliado à parte, e sem esta regra a galeria cairia na
    // regra de banner (mesmos limites, mas menos explícito).
    match /events/{eventId}/gallery/{fileName} {
      allow read:  if true;
      allow write: if isPanelUser() && underMB(5) && isImage('jpeg|png|webp');
    }

    // ── Vídeo da seção de vídeo de uma edição (videoBlock) ──
    // Subpasta própria, e declarada ANTES do curinga de banner
    // (events/{eventId}/{fileName}), pelo mesmo motivo da galeria acima:
    // sem ela o vídeo cairia na regra de banner, que exige imagem de até
    // 5MB — e todo upload de vídeo seria recusado pelo servidor.
    match /events/{eventId}/video/{fileName} {
      allow read:  if true;
      allow write: if isPanelUser()
                   && underMB(100)
                   && (request.resource.contentType == 'video/mp4'
                       || request.resource.contentType == 'video/webm');
    }

    // ── Depoimentos em vídeo (MP4) — testimonials embutidos em um evento ──
    match /events/{eventId}/testimonials/{fileName} {
      allow read:  if true;
      allow write: if isPanelUser()
                   && underMB(100)
                   && request.resource.contentType == 'video/mp4';
    }

    // ── Depoimentos em vídeo (MP4) — coleção testimonials (/painel/depoimentos) ──
    match /testimonials/{testimonialId}/{fileName} {
      allow read:  if true;
      allow write: if isPanelUser()
                   && underMB(100)
                   && request.resource.contentType == 'video/mp4';
    }

    // ── Banners de evento (desktop/tablet/mobile) ──
    match /events/{eventId}/{fileName} {
      allow read:  if true;
      allow write: if isPanelUser() && underMB(5) && isImage('jpeg|png|webp');
    }

    // ── Banners manuais do carrossel da Home (desktop/tablet/mobile) ──
    match /banners/{bannerId}/{fileName} {
      allow read:  if true;
      allow write: if isPanelUser() && underMB(5) && isImage('jpeg|png|webp');
    }

    // ── Imagem de preview de link (og:image) ──
    // Configuração global do site, editada em /painel/redes-sociais e lida
    // pelo scripts/prerender-seo.mjs na hora do build.
    //
    // A leitura pública aqui não é só "o site exibe": são os crawlers de
    // WhatsApp, Facebook e LinkedIn que buscam este arquivo direto, sem
    // sessão nenhuma. Sem `allow read: if true` o preview não apareceria.
    //
    // O teto de 2MB é o limite DURO, o que de fato barra. O aviso de 600KB
    // (acima disso o WhatsApp deixa de exibir a miniatura grande) é só no
    // cliente e não bloqueia: uma imagem de 700KB continua sendo escolha
    // válida do administrador, ver UPLOAD_PRESETS.ogImage.
    match /settings/og/{fileName} {
      allow read:  if true;
      allow write: if isPanelUser() && underMB(2) && isImage('jpeg|png|webp');
    }
  }
}
